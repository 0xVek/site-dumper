{
  "manifest_version": 3,
  "name": "Site Dumper",
  "version": "6.0",
  "description": "Force-load every asset on a page (scroll, lazy images, interactions), then dump the full site to a deployable ZIP.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icon.png",
      "48":  "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16":  "icon.png",
    "48":  "icon.png",
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["jszip.min.js"],
      "matches":   ["<all_urls>"]
    }
  ]
}
